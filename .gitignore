# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated scorecard and run provenance (run output; see examples/ for committed copies)
/scorecard.md
/scorecard.json
/run-provenance.json

# Generated run history: every evaluate run writes history/ under its --out directory;
# not tracked. The regression gate's committed baseline is examples/regression-baseline.json.
**/history/run_*.json

# SQLite / local databases
*.db
*.sqlite
*.sqlite3

# Environment files
.env

# Capture artifacts from local runs. Public examples are committed under examples/captures/.
/captures/

# Exported annotation bundle, regenerate with make annotation-bundle
/annotations/bundle/

# Zipped candidate annotation pack, regenerate with make candidate-bundle
/candidates/mycounsel/annotation-bundle/

# Static GitHub Pages site, regenerate with make site
/site/

# Environment files. Real values stay local; only example files are tracked.
.env.*
!.env.example
