{
  "schema": "contract-review-eval.release-certificate.v3",
  "policy": {
    "policy_id": "contract-review-eval.strict-legal-release-policy.v2.1",
    "requirements": [
      {
        "requirement_id": "citation.grounding",
        "metric": "citation_grounding",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "blocker",
        "failure_code": "citation_grounding_below_100_percent",
        "description": "Every citation must match an exact span of the normalised source."
      },
      {
        "requirement_id": "citation.unsupported",
        "metric": "hallucination_count",
        "comparator": "zero",
        "threshold": null,
        "failure_class": "blocker",
        "failure_code": "unsupported_citation_detected",
        "description": "No citation may be unsupported by the source document."
      },
      {
        "requirement_id": "citation.length",
        "metric": "citation_short_count",
        "comparator": "zero",
        "threshold": null,
        "failure_class": "blocker",
        "failure_code": "degenerate_citation_detected",
        "description": "Every citation must quote at least three words of the source; a one- or two-word match is not a quotation."
      },
      {
        "requirement_id": "clause.precision",
        "metric": "clause_precision",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "review_item",
        "failure_code": "unexpected_clause_extracted",
        "description": "No clause may be reported that the gold set does not declare."
      },
      {
        "requirement_id": "clause.recall",
        "metric": "clause_recall",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "review_item",
        "failure_code": "expected_clause_missed",
        "description": "Every gold clause must be found."
      },
      {
        "requirement_id": "risk.precision",
        "metric": "risk_precision",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "review_item",
        "failure_code": "risk_false_positive",
        "description": "No clause may be flagged that the gold set does not treat as a risk."
      },
      {
        "requirement_id": "risk.recall",
        "metric": "risk_recall",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "review_item",
        "failure_code": "expected_risk_missed",
        "description": "Every gold risk must be flagged."
      },
      {
        "requirement_id": "risk.severity",
        "metric": "risk_severity_accuracy",
        "comparator": "gte",
        "threshold": 1.0,
        "failure_class": "review_item",
        "failure_code": "risk_severity_mismatch",
        "description": "Every jointly identified risk must carry the gold severity."
      },
      {
        "requirement_id": "risk.duplicates",
        "metric": "risk_duplicate_flags",
        "comparator": "empty",
        "threshold": null,
        "failure_class": "review_item",
        "failure_code": "duplicate_risk_flags",
        "description": "No two predictions may collapse onto one clause."
      },
      {
        "requirement_id": "risk.conflicts",
        "metric": "risk_conflicting_flags",
        "comparator": "empty",
        "threshold": null,
        "failure_class": "review_item",
        "failure_code": "conflicting_risk_flags",
        "description": "One clause may not carry contradictory severities."
      },
      {
        "requirement_id": "risk.evidence",
        "metric": "risk_flags_without_evidence",
        "comparator": "empty",
        "threshold": null,
        "failure_class": "review_item",
        "failure_code": "risk_flag_without_evidence",
        "description": "Every flagged clause must have a grounded citation inside that clause's region of the source."
      }
    ],
    "hard_blockers": [
      "citation_grounding_below_100_percent",
      "unsupported_citation_detected",
      "degenerate_citation_detected"
    ],
    "diagnostics_only": [
      "clause_f1",
      "risk_f1",
      "risk_flag_accuracy",
      "risk_false_positives",
      "risk_missed",
      "risk_severity_confusion",
      "span_coverage",
      "span_uncovered_clauses",
      "citation_grounded",
      "citation_total"
    ]
  },
  "suite_decision": "REJECT",
  "summary": {
    "cases": 3,
    "rejected": 3,
